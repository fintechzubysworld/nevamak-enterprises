    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <!-- ===== FIX: Add referrer policy for CDN ===== -->
    <meta name="referrer" content="no-referrer-when-crossorigin">
    <title>NEVAMAK – Dashboard</title>

    <!-- ===== EARLY DEFINITION FOR EXTENSION COMPATIBILITY ===== -->
    <script>
        // Define these globally before any extension scripts run
        window.ActionableCoachmark = function() { console.log("ActionableCoachmark placeholder"); };
