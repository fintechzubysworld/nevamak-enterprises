    <!-- Shipments Table -->
    <div class="section-card">
        <div class="section-title">📋 Live Shipments <span><input type="text" id="shipmentSearch" placeholder="🔍 Search..." style="padding:6px; border-radius:40px; border:1px solid #ccc; font-size:0.9rem;"></span></div>
        <div style="overflow-x:auto;">
            <table>
                <thead><tr><th>ID</th><th>Sender</th><th>Dest</th><th>Items</th><th>Goods</th><th>Transport</th><th>Status</th><th>Date</th><th>Action</th></tr></thead>
                <tbody id="shipmentsBody"><tr><td colspan="9">Loading...</td></tr></tbody>
            </table>
        </div>
    </div>

    <!-- Inventory Summary -->
    <div class="section-card">
        <div class="section-title">📦 Inventory Summary</div>
        <div id="inventorySummary">Loading...</div>
    </div>

    <!-- Returns Log -->
    <div class="section-card">
        <div class="section-title">🔄 Returns Log</div>
        <table>
            <thead><tr><th>Date</th><th>Branch</th><th>Shipment</th><th>Item</th><th>Qty</th><th>Reason</th><th>By</th></tr></thead>
            <tbody id="returnsBody"><tr><td colspan="7">Loading...</td></tr></tbody>
        </table>
