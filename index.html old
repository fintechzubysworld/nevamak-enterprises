    <!-- Notifications -->
    <div class="section-card" style="position:relative;">
        <div class="section-title">🔔 Notifications <span class="notification-bell" id="notifBell">🔔 <span class="notification-badge" id="notifCount">0</span></span></div>
        <div class="notification-panel" id="notifPanel"></div>
