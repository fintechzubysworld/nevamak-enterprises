                        if (role === 'vendor' || role === 'external_vendor') {
                            window.location.replace('external_vendor.html');
                        }
                    }
                } catch (e) {
                    console.warn('Vendor redirect check error:', e);
                }
            }
        });
    })();

    // ==================== Main Application ====================
    const firebaseConfig = {
        apiKey: "AIzaSyBL_OZw3GmNHWjwBdGCc4F-5nUXEy5ZIcI",
        authDomain: "nevamak-enterprises.firebaseapp.com",
        projectId: "nevamak-enterprises",
        storageBucket: "nevamak-enterprises.firebasestorage.app",
        messagingSenderId: "144324172534",
        appId: "1:144324172534:web:4b6dd31754c79fd830aad7",
        measurementId: "G-MZ8NT6KK8N"
    };
    if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
    const auth2 = firebase.auth();
    const db2 = firebase.firestore();
    let currentUser, currentRole;

    // ============================================================
    // ===== FIX 1: DEFINE loadPendingRequests GLOBALLY =====
    // ============================================================
    window.loadPendingRequests = function() {
        console.log("🔄 loadPendingRequests: Fetching pending invoice requests...");
        const container = document.getElementById('pendingRequestsList');
        container.innerHTML = '<div style="color:#888; padding:10px;">Loading pending requests...</div>';

        // Query for pending invoice requests
        db2.collection('invoiceRequests')
            .where('status', '==', 'pending')
            .orderBy('createdAt', 'desc')
            .limit(20)
            .get()
            .then((snapshot) => {
                if (snapshot.empty) {
                    container.innerHTML = '<div style="color:#888; padding:10px;">✅ No pending invoice requests.</div>';
                    return;
                }

                let html = `
                    <table>
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Requested By</th>
                                <th>Items</th>
                                <th>Total Value</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                `;

                snapshot.forEach((doc) => {
                    const data = doc.data();
                    const itemsCount = data.items ? data.items.length : 0;
                    const totalValue = data.items ? data.items.reduce((sum, i) => sum + (i.totalItemCost || 0), 0) : 0;
                    const dateStr = data.createdAt ? new Date(data.createdAt.toDate()).toLocaleDateString() : 'N/A';
                    
                    html += `
                        <tr>
                            <td><strong>#${doc.id.slice(0, 8)}</strong></td>
                            <td>${data.requestedBy || 'N/A'}</td>
                            <td>${itemsCount} items</td>
                            <td class="cost-cell">₦${totalValue.toLocaleString()}</td>
                            <td>${dateStr}</td>
                            <td>
                                <button onclick="approveInvoiceRequest('${doc.id}')" class="btn-sm btn-success">✅ Approve</button>
                                <button onclick="rejectInvoiceRequest('${doc.id}')" class="btn-sm btn-danger">❌ Reject</button>
                                <button onclick="viewInvoiceRequest('${doc.id}')" class="btn-sm btn-info">👁️ View</button>
                            </td>
                        </tr>
                    `;
                });

                html += '</tbody></table>';
                container.innerHTML = html;
            })
            .catch((error) => {
                console.error('Error loading pending requests:', error);
                container.innerHTML = `<div style="color:#e74c3c; padding:10px;">❌ Error loading: ${error.message}</div>`;
            });
    };

    // ============================================================
    // ===== FIX 2: showOneChild is already defined early =====
    // ============================================================

    // ============================================================
    // ===== Additional functions for pending requests =====
    // ============================================================
    window.approveInvoiceRequest = function(requestId) {
        if (!confirm('✅ Approve this invoice request?')) return;
        db2.collection('invoiceRequests').doc(requestId).update({
            status: 'approved',
            approvedAt: firebase.firestore.FieldValue.serverTimestamp(),
            approvedBy: currentUser?.uid || 'system'
        }).then(() => {
            alert('✅ Invoice request approved!');
            loadPendingRequests();
        }).catch(err => {
            alert('❌ Error: ' + err.message);
            console.error('Approve error:', err);
        });
    };

    window.rejectInvoiceRequest = function(requestId) {
        if (!confirm('❌ Reject this invoice request?')) return;
        const reason = prompt('Reason for rejection (optional):');
        db2.collection('invoiceRequests').doc(requestId).update({
            status: 'rejected',
            rejectedAt: firebase.firestore.FieldValue.serverTimestamp(),
            rejectedBy: currentUser?.uid || 'system',
            rejectionReason: reason || 'No reason provided'
        }).then(() => {
            alert('❌ Invoice request rejected.');
            loadPendingRequests();
        }).catch(err => {
            alert('❌ Error: ' + err.message);
            console.error('Reject error:', err);
        });
    };

    window.viewInvoiceRequest = async function(requestId) {
        try {
            const doc = await db2.collection('invoiceRequests').doc(requestId).get();
            if (!doc.exists) {
                alert('Request not found.');
                return;
            }
            const data = doc.data();
            let itemsHtml = '<table><tr><th>Item</th><th>Qty</th><th>Unit Price</th><th>Total</th></tr>';
            if (data.items && data.items.length > 0) {
                data.items.forEach(item => {
                    itemsHtml += `<tr>
                        <td>${item.itemName || 'N/A'}</td>
                        <td>${item.orderedQty || 0}</td>
                        <td>₦${(item.unitPrice || 0).toLocaleString()}</td>
                        <td>₦${(item.totalItemCost || 0).toLocaleString()}</td>
                    </tr>`;
                });
            } else {
                itemsHtml += '<tr><td colspan="4">No items</td></tr>';
            }
            itemsHtml += '</table>';

            const totalValue = data.items ? data.items.reduce((s, i) => s + (i.totalItemCost || 0), 0) : 0;

            alert(`
📄 INVOICE REQUEST DETAILS
━━━━━━━━━━━━━━━━━━━━━━━
Request ID: ${requestId}
Requested By: ${data.requestedBy || 'N/A'}
Status: ${data.status || 'pending'}
Date: ${data.createdAt ? new Date(data.createdAt.toDate()).toLocaleString() : 'N/A'}
Total Value: ₦${totalValue.toLocaleString()}
Notes: ${data.notes || 'N/A'}

Items:
${data.items ? data.items.map(i => `  • ${i.itemName} x${i.orderedQty} = ₦${(i.totalItemCost || 0).toLocaleString()}`).join('\n') : '  No items'}
            `);
        } catch (error) {
            alert('Error viewing request: ' + error.message);
        }
    };

    // ============================================================
    // ===== FIX 3: Suppress extension errors =====
    // ============================================================
    window.addEventListener('error', function(e) {
        // Ignore errors that are clearly from extensions
        if (e.filename && e.filename.includes('chrome-extension://')) {
            console.warn('🛑 Extension error ignored:', e.message);
            e.preventDefault();
            return true;
        }
    }, true);

    // ============================================================
    // ===== End of FIXES - Original code continues below =====
    // ============================================================

    auth2.onAuthStateChanged(async (user) => {
        if (!user) { window.location.href = 'login.html'; return; }
        currentUser = user;
        const userDoc = await db2.collection('users').doc(user.uid).get();
        currentRole = userDoc.data()?.role || '';
        document.getElementById('roleBadge').innerText = `Role: ${currentRole}`;
        if (currentRole === 'admin') {
            document.getElementById('adminPanelLink').style.display = 'inline-block';
            document.getElementById('permissionsLink').style.display = 'inline-block';
            const usersLink = document.getElementById('usersLink'); if (usersLink) usersLink.style.display = 'inline-block';
        } else if (currentRole === 'lagos_sender') {
            document.getElementById('permissionsLink').style.display = 'inline-block';
            const usersLink = document.getElementById('usersLink'); if (usersLink) usersLink.style.display = 'none';
        } else {
            const usersLink = document.getElementById('usersLink'); if (usersLink) usersLink.style.display = 'none';
        }

        // Show pending requests only for admin or lagos_sender
        if (currentRole === 'admin' || currentRole === 'lagos_sender') {
            document.getElementById('pendingRequestsSection').style.display = 'block';
            loadPendingRequests();
        }

        startListeners();
        loadInventory();
        loadAudit();
        loadNotifications();
        initCharts();
    });
    document.getElementById('logoutBtn').addEventListener('click', () => auth2.signOut().then(() => window.location.href = 'login.html'));

    // ---- Charts ----
    let shipmentChart, costChart;
    function initCharts() {
        const ctx1 = document.getElementById('shipmentChart').getContext('2d');
        const ctx2 = document.getElementById('costChart').getContext('2d');
        shipmentChart = new Chart(ctx1, { type: 'line', data: { labels: [], datasets: [{ label: 'Shipments', data: [], borderColor: '#0a3d62', fill: false }] }, options: { responsive: true } });
        costChart = new Chart(ctx2, { type: 'bar', data: { labels: [], datasets: [{ label: 'Goods Value (₦)', data: [], backgroundColor: '#3c6382' }] }, options: { responsive: true } });
    }
    function updateCharts(data) {
        const labels = data.map(d => d.date);
        shipmentChart.data.labels = labels;
        shipmentChart.data.datasets[0].data = data.map(d => d.count);
        shipmentChart.update();
        costChart.data.labels = labels;
        costChart.data.datasets[0].data = data.map(d => d.value);
        costChart.update();
    }

    // ---- Listeners ----
    function startListeners() {
        // Build shipments query based on role
        let q = db2.collection("shipments").orderBy("createdAt", "desc");
        if (currentRole === 'abuja_rep') {
            q = db2.collection("shipments").where("destinationBranch", "==", "Abuja").orderBy("createdAt", "desc");
        } else if (currentRole === 'ph_rep') {
            q = db2.collection("shipments").where("destinationBranch", "==", "Portharcourt").orderBy("createdAt", "desc");
        }
        // For admin/lagos_sender, no filter needed

        q.onSnapshot((snapshot) => {
            let total=0, abuja=0, ph=0, delivered=0, totalGoods=0, totalTrans=0, rows=[];
            let chartData = {};
            snapshot.forEach(doc => {
                const d = doc.data();
                total++;
                if (d.destinationBranch==="Abuja") abuja++;
                if (d.destinationBranch==="Portharcourt") ph++;
                if (d.status==="Delivered") delivered++;
                let goods=0; if(d.items) d.items.forEach(i=>goods+=i.totalItemCost||0);
                totalGoods+=goods; totalTrans+=(d.transportCost||0);
                const date = d.createdAt ? new Date(d.createdAt.toDate()).toLocaleDateString() : 'unknown';
                if (!chartData[date]) chartData[date] = { count:0, value:0 };
                chartData[date].count++;
                chartData[date].value += goods;
                const statusClass = `status status-${d.status?.toLowerCase().replace(/\s/g,'')||'dispatched'}`;
                const itemsShort = d.items ? d.items.map(i=>`${i.itemName}(${i.orderedQty})`).join(", ").substring(0,40) : "-";
                const lastUpdate = d.receivedDate ? new Date(d.receivedDate.toDate()).toLocaleDateString() : (d.createdAt ? new Date(d.createdAt.toDate()).toLocaleDateString() : "N/A");
                rows.push(`<tr>
                    <td><strong>${doc.id.slice(0,6)}</strong></td>
                    <td>${d.senderName||"—"}</td>
                    <td><span class="badge">${d.destinationBranch}</span></td>
                    <td class="items-cell">${itemsShort}</td>
                    <td class="cost-cell">₦${goods.toLocaleString()}</td>
                    <td class="cost-cell">₦${(d.transportCost||0).toLocaleString()}</td>
                    <td><span class="${statusClass}">${d.status}</span></td>
                    <td>${lastUpdate}</td>
                    <td><button onclick="viewShipment('${doc.id}')" style="background:#3c6382; border:none; border-radius:40px; padding:4px 12px; color:white; cursor:pointer;">View</button></td>
                </tr>`);
            });
            document.getElementById("totalShipments").innerText = total;
            document.getElementById("toAbuja").innerText = abuja;
            document.getElementById("toPH").innerText = ph;
            document.getElementById("deliveredCount").innerText = delivered;
            document.getElementById("totalValue").innerText = `₦${totalGoods.toLocaleString()}`;
            document.getElementById("totalTransport").innerText = `₦${totalTrans.toLocaleString()}`;
            document.getElementById("shipmentsBody").innerHTML = rows.length ? rows.join("") : "<tr><td colspan='9'>No shipments</td></tr>";
            const sorted = Object.keys(chartData).sort().slice(-30);
            const dataForChart = sorted.map(k => ({ date: k, count: chartData[k].count, value: chartData[k].value }));
            updateCharts(dataForChart);
        }, err => console.error('Shipments listener error:', err));

        db2.collection("returns").orderBy("date","desc").onSnapshot(snap => {
            let returnRows="", totalReturned=0;
            snap.forEach(doc => {
                const r = doc.data();
                totalReturned += r.returnedQty;
                returnRows += `<tr><td>${new Date(r.date?.toDate()).toLocaleDateString()}</td><td>${r.branch}</td><td>${r.shipmentId.slice(0,6)}</td><td>${r.itemName}</td><td>${r.returnedQty}</td><td>${r.reason||''}</td><td>${r.by||''}</td></tr>`;
            });
            document.getElementById("returnedCount").innerText = totalReturned;
            document.getElementById("returnsBody").innerHTML = returnRows || "<tr><td colspan='7'>No returns</td></tr>";
        }, err => console.error('Returns listener error:', err));
    }

    // ---- Inventory ----
    async function loadInventory() {
        try {
            const snap = await db2.collection('inventory').get();
            if (snap.empty) {
                document.getElementById('inventorySummary').innerHTML = '<p>No inventory data available. Please create inventory via receiving goods.</p>';
                document.getElementById('inStockCount').innerText = '0';
                return;
            }
            let totalStock = 0;
            let html = '<table><tr><th>Item</th><th>Branch</th><th>Stock</th><th>Unit Price</th></tr>';
            snap.forEach(doc => {
                const d = doc.data();
                totalStock += d.stock || 0;
                html += `<tr><td>${d.itemName}</td><td>${d.branch}</td><td>${d.stock}</td><td>₦${d.unitPrice?.toLocaleString()}</td></tr>`;
            });
            html += '</table>';
            document.getElementById('inventorySummary').innerHTML = html;
            document.getElementById('inStockCount').innerText = totalStock;
        } catch (error) {
            console.error('Error loading inventory:', error);
            document.getElementById('inventorySummary').innerHTML = `<p>⚠️ Error loading inventory: ${error.message}. Check Firestore permissions.</p>`;
            document.getElementById('inStockCount').innerText = '0';
        }
    }

    // ---- Audit Log ----
    async function loadAudit() {
        try {
            const snap = await db2.collection('activityLog').orderBy('timestamp','desc').limit(50).get();
            let html = '';
            snap.forEach(doc => {
                const a = doc.data();
                html += `<div style="border-bottom:1px solid #eee; padding:4px 0;">${a.timestamp ? new Date(a.timestamp.toDate()).toLocaleDateString() : ''} - <strong>${a.user}</strong> ${a.actionType || ''}</div>`;
            });
            document.getElementById('auditLog').innerHTML = html || 'No activity';
        } catch (error) {
            console.error('Error loading audit log:', error);
            document.getElementById('auditLog').innerHTML = '<p>Error loading audit log.</p>';
        }
    }

    // ---- Notifications ----
    function loadNotifications() {
        db2.collection('notifications').where('userId','==',currentUser?.uid).orderBy('timestamp','desc').limit(20).onSnapshot(snap => {
            let count = 0;
            let html = '';
            snap.forEach(doc => {
                const n = doc.data();
                if (!n.read) count++;
                html += `<div style="border-bottom:1px solid #eee; padding:4px 0; ${n.read ? 'opacity:0.7;' : ''}">${n.message} - ${new Date(n.timestamp?.toDate()).toLocaleDateString()}</div>`;
                if (!n.read) doc.ref.update({ read: true });
            });
            document.getElementById('notifCount').innerText = count;
            document.getElementById('notificationList').innerHTML = html || 'No notifications';
        }, err => console.error('Notifications error:', err));
    }

    // ---- Search ----
    document.getElementById('shipmentSearch').addEventListener('input', function() {
        const q = this.value.toLowerCase();
        const rows = document.querySelectorAll('#shipmentsBody tr');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(q) ? '' : 'none';
        });
    });

    // ---- View Shipment Details ----
    window.viewShipment = async function(id) {
        try {
            const doc = await db2.collection('shipments').doc(id).get();
            if (!doc.exists) return alert('Shipment not found.');
            const d = doc.data();
            let itemsHtml = '<table><tr><th>Item</th><th>Qty Ordered</th><th>Unit Price</th><th>Total</th><th>Received</th><th>Damaged</th></tr>';
            if (d.items && d.items.length > 0) {
                d.items.forEach(it => {
                    itemsHtml += `<tr>
                        <td>${it.itemName}</td>
                        <td>${it.orderedQty}</td>
                        <td>₦${it.unitPrice?.toLocaleString()}</td>
                        <td>₦${(it.totalItemCost||0).toLocaleString()}</td>
                        <td>${it.receivedQty || 0}</td>
                        <td>${it.damageQty || 0}</td>
                    </tr>`;
                });
            } else {
                itemsHtml += '<tr><td colspan="6">No items</td></tr>';
            }
            const totalGoods = d.items ? d.items.reduce((s,i)=>s+(i.totalItemCost||0),0) : 0;
            const statusClass = `status status-${d.status?.toLowerCase().replace(/\s/g,'')||'dispatched'}`;
            const html = `
                <p><strong>Shipment ID:</strong> ${id.slice(0,8)}</p>
                <p><strong>Sender:</strong> ${d.senderName}</p>
                <p><strong>Destination:</strong> ${d.destinationBranch}</p>
                <p><strong>Vehicle:</strong> ${d.vehicleNo || 'N/A'}</p>
                <p><strong>Tracking #:</strong> ${d.trackingNo || 'N/A'}</p>
                <p><strong>Expected Date:</strong> ${d.expectedDate || 'N/A'}</p>
                <p><strong>Driver:</strong> ${d.driver || 'N/A'}</p>
                <p><strong>Status:</strong> <span class="status ${statusClass}">${d.status}</span></p>
                <p><strong>Total Goods Value:</strong> ₦${totalGoods.toLocaleString()}</p>
                <p><strong>Transport Cost:</strong> ₦${(d.transportCost||0).toLocaleString()}</p>
                <p><strong>Created:</strong> ${d.createdAt ? new Date(d.createdAt.toDate()).toLocaleDateString() : ''}</p>
                ${d.receivedDate ? `<p><strong>Received:</strong> ${new Date(d.receivedDate.toDate()).toLocaleDateString()}</p>` : ''}
                ${d.notes ? `<p><strong>Notes:</strong> ${d.notes}</p>` : ''}
                <h4>Items</h4>
                ${itemsHtml}
            `;
            document.getElementById('viewShipmentContent').innerHTML = html;
            document.getElementById('viewShipmentModal').style.display = 'flex';
        } catch (error) {
            alert('Error loading shipment details: ' + error.message);
        }
    };

    // ---- Notification bell ----
    document.getElementById('notifBell').addEventListener('click', () => {
        document.getElementById('notifPanel').classList.toggle('show');
    });

    // ---- Modal close ----
    function closeModal(id) {
        document.getElementById(id).style.display = 'none';
        document.getElementById('approveMessage').innerText = '';
    }
    window.onclick = function(event) {
        if (event.target.classList.contains('modal')) {
            event.target.style.display = 'none';
            document.getElementById('approveMessage').innerText = '';
        }
    };

    console.log('🚀 NEVAMAK Dashboard loaded successfully with all fixes applied.');
</script>
</body>
</html>
