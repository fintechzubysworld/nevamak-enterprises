    </div>

    <!-- ===== FIX: Pending Invoice Requests Section (now fully functional) ===== -->
    <div id="pendingRequestsSection" class="section-card" style="display:none;">
        <div class="section-title">📋 Pending Invoice Requests</div>
        <div id="pendingRequestsList">Loading...</div>
